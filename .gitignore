# Dependencies (root and all subfolders)
node_modules/
**/node_modules/
package-lock.json.backup

# Environment files - NEVER commit secrets
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# Local SQLite databases & runtime data
server/data/*.sqlite*
server/data/*.db*
*.sqlite
*.sqlite3

# Build outputs that can be rebuilt
dist/
**/dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# System and editor files
.DS_Store
Thumbs.db
.vscode/
.idea/
