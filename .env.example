# VRUDHSEVA Environment Configuration Example
# Copy this file to .env and configure your keys

PORT=3000

# Groq API Configuration for SevaBot (Elderly & Dementia Care Query Assistant)
# Obtain your API key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# Telegram Caregiver Notification Bot
# Obtain your Bot token from BotFather (t.me/BotFather)
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_BOT_USERNAME=VRUSHSEVABOT
TELEGRAM_CHAT_ID=
